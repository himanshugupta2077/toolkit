# /etc/toolkit.env  (root:toolkit, mode 0640)
# Do NOT copy the laptop .env as-is. Create this file on the VPS and paste keys.
#   sudo cp ~/stage/toolkit/vps/env.vps.sample /etc/toolkit.env
#   sudo chmod 640 /etc/toolkit.env
#   sudo chown root:toolkit /etc/toolkit.env
#   sudo nano /etc/toolkit.env
#
# Never print this file. Never git it.

# --- bind (mandatory) ---
HOST=127.0.0.1
PORT=8000
TOOLKIT_PROFILE=vps
TOOLKIT_REQUIRE_LOOPBACK=1
TOOLKIT_STT=cloud
TOOLKIT_DATA=/var/lib/toolkit

# Do not spawn a second Node. finance.service already owns 127.0.0.1:8787
FINANCE_OS=0
FINANCE_OS_PORT=8787

# Tailscale Serve is systemd/toolkit-serve, not run.sh
TAILSCALE_SERVE=0

# --- keys (paste from laptop .env, same values) ---
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...

# Optional
# OPENAI_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

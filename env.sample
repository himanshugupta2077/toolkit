# Toolkit secrets / host config
# Copy to .env (gitignored) and fill in:
#   cp env.sample .env
#   chmod 600 .env
#
# Never commit .env. Keys stay on this machine; the phone UI never sees them.

# --- Host ---
# local = laptop (GPU Whisper available; UI can pick local or cloud)
# vps   = VPS (local Whisper disabled; cloud only)
TOOLKIT_PROFILE=local

# Default speech engine when both are allowed: local | cloud
# Ignored on vps (always cloud).
TOOLKIT_STT=local

# --- Cloud speech (OpenAI whisper-1) ---
# https://developers.openai.com/api/docs/models/whisper-1
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_STT_MODEL=whisper-1
# OPENAI_STT_TIMEOUT_SEC=180

# --- DeepSeek (finance ledger + food meal AI + optional Voice note titles) ---
DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_RECEIPT_MODE=auto

# --- Local Whisper (laptop only; ignored for cloud STT) ---
# WHISPER_MODEL=medium
# WHISPER_DEVICE=cuda
# WHISPER_PRELOAD=0
# WHISPER_KEEP_ALIVE_SEC=45
# WHISPER_LANGUAGE=

# --- Optional ---
# FINANCE_WORKBOOK=
# TAILSCALE_SERVE=1
# PORT=8000

# --- VPS (do not use this laptop file on the droplet) ---
# Create /etc/toolkit.env from vps/env.vps.sample instead.
# TOOLKIT_PROFILE=vps
# HOST=127.0.0.1
# FINANCE_OS=0
# TOOLKIT_DATA=/var/lib/toolkit
